# ---- Feekr environment (copy to .env for local, set in Vercel for prod) ----

# Auth (REQUIRED in production — app refuses to boot if unset/weak)
SESSION_SECRET="generate-a-random-32+char-string"      # e.g. `openssl rand -hex 32`

# Admin seed credentials (used by scripts/seed.mjs)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"

# ---- Supabase (project: Feekr / vjxvudfjzhfplezplrrw) ----
# Postgres — copy the EXACT strings from Supabase dashboard → Connect → ORMs/Prisma.
# DATABASE_URL = Transaction pooler (port 6543, add ?pgbouncer=true), DIRECT_URL = Session/direct (5432).
DATABASE_URL="postgresql://postgres.vjxvudfjzhfplezplrrw:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.vjxvudfjzhfplezplrrw:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Storage (server-side). SERVICE_ROLE_KEY is SECRET — never expose to the client.
SUPABASE_URL="https://vjxvudfjzhfplezplrrw.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service_role key from dashboard → Settings → API]"

# Public site URL (for metadata / OG). Set to your Vercel/production domain.
NEXT_PUBLIC_SITE_URL="https://feekrfont.uz"

# ---- Login (OPTIONAL — each method hides itself until its vars are set) ----

# Google OAuth (Google Cloud Console → Auth Platform → Clients)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Eskiz.uz SMS (my.eskiz.uz) — used for phone-number login codes
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
