generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // Supabase pooler (pgbouncer) connection
  directUrl = env("DIRECT_URL")    // direct connection for migrations
}

model Family {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  folder       String
  category     String   @default("Display")
  designer     String?
  manufacturer String?
  designerUrl  String?
  copyright    String?
  license      String?
  licenseUrl   String?
  licenseClass String   @default("Unknown")
  version      String?
  glyphs       Int      @default(0)
  hasLatin     Boolean  @default(true)
  hasCyrillic  Boolean  @default(false)
  hasItalic    Boolean  @default(false)
  styleCount   Int      @default(0)

  // editorial / commerce (admin-editable)
  tagline     String?
  description String? // long editorial "CTA" text
  history     String?
  usage       String?
  priceCents  Int      @default(100)
  isFree      Boolean  @default(false)
  tier        String   @default("demo") // free | demo | paid
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  popularity  Int      @default(0)
  downloads   Int      @default(0) // ZIP + single-cut downloads, counted by the download routes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  styles    Style[]

  @@index([category])
  @@index([isFeatured])
  // Composite indexes matching the /fonts catalog access paths (filter by
  // isPublished, then sort). Replaces the low-cardinality boolean index.
  @@index([isPublished, popularity])
  @@index([isPublished, name])
  @@index([isPublished, styleCount])
}

model Style {
  id        Int     @id @default(autoincrement())
  familyId  Int
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  style     String
  subfamily String?
  weight    Int     @default(400)
  italic    Boolean @default(false)
  ext       String
  file      String
  size      Int     @default(0)

  // One row per (family, style-name); also serves as the familyId lookup index.
  @@unique([familyId, style])
}

model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  type        String    @default("blog") // blog | news | article
  title       String
  excerpt     String?
  body        String    @default("")
  coverImage  String?
  author      String    @default("Feekr")
  tags        String    @default("")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([isPublished, publishedAt])
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  mime      String?
  width     Int?
  height    Int?
  size      Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Order {
  id         Int      @id @default(autoincrement())
  itemsJson  String // JSON array of {slug,name,priceCents}
  totalCents Int
  contact    String // email or Telegram handle the customer left for follow-up
  status     String   @default("new") // new | contacted | done
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  paymeTransactions PaymeTransaction[]
  clickTransactions ClickTransaction[]

  @@index([status, createdAt])
  @@index([userId])
}

// Payme's own transaction bookkeeping, keyed by the transaction id Payme
// generates (not our Order id) — required by the Merchant API's
// Check/Create/Perform/Cancel/CheckTransaction methods to be idempotent.
model PaymeTransaction {
  id          String   @id
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  amount      Int // tiyin
  state       Int      @default(1) // 1 created | 2 performed | -1 cancelled(created) | -2 cancelled(performed)
  reason      Int?
  createTime  BigInt
  performTime BigInt   @default(0)
  cancelTime  BigInt   @default(0)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// Click's two-phase Prepare/Complete bookkeeping, keyed by Click's own
// click_trans_id.
model ClickTransaction {
  id         String   @id // click_trans_id
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Int // so'm
  preparedId Int? // merchant_prepare_id we hand back from Prepare
  status     String   @default("prepared") // prepared | confirmed | cancelled
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// A regular (non-admin) site account. Email+password, Google, and phone+SMS
// are all optional login paths onto the same account — at least one of
// email/phone/googleId is expected to be set.
model User {
  id           Int        @id @default(autoincrement())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  googleId     String?    @unique
  name         String?
  createdAt    DateTime   @default(now())
  orders       Order[]
  purchases    Purchase[]
}

// A confirmed entitlement: this user owns the full (non-demo) license for
// this font family, regardless of how the sale happened (admin manually
// marking an order paid today; an automated Payme/Click/Paynet webhook once
// those are wired up). "Mening xaridlarim" reads from here, not from Order.
model Purchase {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  familySlug String
  familyName String
  priceCents Int
  provider   String   @default("manual") // manual | payme | click | paynet
  orderId    Int? // the Order this purchase originated from, if any
  createdAt  DateTime @default(now())

  @@unique([userId, familySlug])
  @@index([userId])
}

// Short-lived one-time codes for phone-number login/verification.
model PhoneOtp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// Persistent (DB-backed) login throttle — replaces an in-memory Map, which does
// not survive across separate serverless function instances on Vercel.
model LoginAttempt {
  key         String    @id // client IP (x-forwarded-for / x-real-ip), falls back to "unknown"
  count       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
